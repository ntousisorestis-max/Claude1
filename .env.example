# Copy this file to .env and fill in the values you need.
# Both variables are optional for local development — the app runs fully
# on demo/local state without either of them.

# Enables the Prisma-backed persistence layer (see prisma/schema.prisma
# and lib/prisma.ts). Not required for the MVP UI, which runs on local
# state — this is scaffolding for a future real backend.
DATABASE_URL="postgresql://user:password@localhost:5432/fixmybusiness?schema=public"

# When set, the AI Business Consultant uses OpenAIProvider (lib/ai/openai)
# instead of the default deterministic SimulatedAIProvider. See lib/ai/index.ts.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
